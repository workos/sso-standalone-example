# Get these from the WorkOS dashboard — use your Staging environment.
# Both are on the API Keys page: the Secret Key and the Client ID.
WORKOS_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxxxx

# Any random string of at least 32 characters; signs the session cookie.
SESSION_SECRET=

# Optional — only needed for the "Testing webhooks" section of the README.
WORKOS_WEBHOOK_SECRET=

# Where this app is reachable. The SSO redirect URI is derived from this:
# {BASE_URL}/auth/sso/callback must be allow-listed in the WorkOS dashboard
# under Redirects.
BASE_URL=http://localhost:3000
PORT=3000
